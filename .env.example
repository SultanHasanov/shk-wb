ADMIN_PASSWORD=replace-with-a-new-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Optional Base32 secret. When set, admin login expects password:123456.
ADMIN_TOTP_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Secret sent by Telegram in every webhook request. Use 16-256 characters: A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Encrypts WB PVZ access tokens stored for the Telegram reviews feature.
WB_SESSION_SECRET=replace-with-at-least-32-random-bytes
# WB Desktop shard for the internal goods history endpoint (for example, 42 means s42).
WB_DESKTOP_SHARD=42
# Internal WB Desktop office ID and external pickpoint ID used by reviews.
WB_DESKTOP_POINT_ID=replace-with-internal-office-id
WB_DESKTOP_EXTERNAL_POINT_ID=replace-with-external-pickpoint-id
WB_DESKTOP_APP_VERSION=v0.37.0
WB_DESKTOP_APP_TYPE=staff
WB_DESKTOP_DEVICE_TYPE=mobile
STICKER_CLIENT_SECRET=replace-with-at-least-32-random-bytes
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# В Production обязательно false. При пустом или отсутствующем значении боевой магазин отображается как тестовый.
YOOKASSA_TEST_MODE=true
PAYMENT_WEBHOOK_SECRET=
REFERRAL_COOKIE_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=ШК ВБ <no-reply@auth.sul-dev.ru>
SUPPORT_EMAIL_FROM=ШК ВБ <no-reply@auth.sul-dev.ru>
SUPPORT_EMAIL_TO=support@example.com
CRON_SECRET=replace-with-at-least-32-random-bytes
# Минимальная версия программы «Подбор кодов» (X-App-Version). Пусто или 0 — проверка
# выключена. Включать только после выкладки установщика этой версии: всё, что старше,
# получит 426 и перестанет искать коды.
PROGRAM_MIN_VERSION=
# Optional. Leave empty on Vercel Preview so VERCEL_URL is used automatically.
PUBLIC_APP_URL=
# Постоянный публичный домен для реферальных ссылок. Пустое значение = https://shk-wb.vercel.app.
# Нельзя оставлять на откуп VERCEL_URL: он содержит адрес конкретной сборки.
PUBLIC_REFERRAL_URL=
