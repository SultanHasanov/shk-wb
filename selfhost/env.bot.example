# /srv/shk-wb/.env на узле бота (Германия, tg.shk-wb.ru). Значения, помеченные «= с VPS», копируются
# с /srv/shk-wb/.env сайта один в один (скриптом по ssh, не через чат). TELEGRAM_API_BASE НЕ задавать:
# отсюда api.telegram.org доступен напрямую.
BOT_ROLE=bot
PORT=3001
PUBLIC_APP_URL=https://shk-wb.ru
# Картинки и PDF стикеров для sendPhoto/sendDocument. НЕ tg.shk-wb.ru:88 — Telegram не скачивает файлы
# с нестандартного порта («wrong type of the web page content», 03.11.2026). Supabase-релей отдаёт их с 443,
# забирая с shk-wb.ru.
STICKER_MEDIA_BASE=https://ouxsvlfaszsaykzpnkwh.supabase.co/functions/v1/tg-relay/media
# Запасной канал для сообщений о здоровье бота, если api.telegram.org вдруг недоступен отсюда.
TELEGRAM_API_FALLBACK_BASE=https://ouxsvlfaszsaykzpnkwh.supabase.co/functions/v1/tg-relay
BOT_HEALTH_STATE=/srv/shk-wb/state/bot-health.json
# Секрет внутреннего RPC с сайта (openssl rand -hex 32); тот же — в BOT_RPC_SECRET на VPS.
BOT_RPC_SECRET=

# = с VPS
# Безлимитные аккаунты (владелец сервиса): без этого узел бота списывал бы им коды клиента при подтверждении.
APP_UNLIMITED_USER_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
STICKER_CLIENT_SECRET=
# WB_SESSION_SECRET — только если задан на VPS (иначе ключ шифрования сессий WB не совпадёт)
REFERRAL_COOKIE_SECRET=
ADMIN_PAYMENT_TELEGRAM_IDS=
CLIENT_CODE_FREE_TELEGRAM_IDS=
REVIEW_FREE_TELEGRAM_IDS=
ZARA_CLUB_CHECK_URL=
CLUB_CHECK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
WB_DESKTOP_APP_TYPE=
WB_DESKTOP_APP_VERSION=
WB_DESKTOP_EXTERNAL_POINT_ID=
WB_DESKTOP_POINT_ID=
WB_DESKTOP_SHARD=
